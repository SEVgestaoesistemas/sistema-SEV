# API
NODE_ENV=development
PORT=3333
HOST=127.0.0.1
FRONTEND_ORIGIN=http://127.0.0.1:5500
# URL completa do aplicativo, usada em links enviados aos integrantes.
# No GitHub Pages deste projeto: https://sevgestaoesistemas.github.io/sistema-SEV/
FRONTEND_URL=http://127.0.0.1:5500
SESSION_TTL_DAYS=7
SESSION_SAME_SITE=lax
# Limite seguro de tentativas de login para clientes.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW="15 minutes"
# Recuperação de senha por SMTP. Em produção, use a senha de app do Gmail em SMTP_PASS.
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
# Chave do Gemini: defina somente no Render, nunca no frontend ou no Git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
# Limites persistentes por dia e por empresa para proteger a cota gratuita.
SUPPORT_CHAT_USER_DAILY_LIMIT=15
SUPPORT_CHAT_ORGANIZATION_DAILY_LIMIT=60
# Mantenha false em produção: novas empresas devem ser criadas pelo administrador da plataforma.
PUBLIC_REGISTRATION_ENABLED=false
# Defina apenas no Render durante a criação do primeiro administrador da plataforma.
PLATFORM_BOOTSTRAP_TOKEN=
TRUST_PROXY=false
# Compartilhe este segredo, de no mínimo 32 caracteres, apenas com o Worker
# Cloudflare que assina o IP do visitante. Nunca versione o valor real.
WORKER_IP_SIGNATURE_SECRET=
# Uso temporário e exclusivo para GET /api/v1/health durante um teste de carga.
# Configure os dois valores no Render e remova ambos quando o teste terminar.
LOAD_TEST_HEALTH_ALLOWED_IP=
LOAD_TEST_HEALTH_BYPASS_EXPIRES_AT=

# PostgreSQL
DATABASE_URL=postgres://sev:sev_local@127.0.0.1:5432/sev
# Para o Supabase, use true mesmo durante o desenvolvimento local.
DATABASE_SSL=false
# Caminho local do certificado raiz baixado no painel do Supabase.
# Exemplo: certs/supabase-ca.crt
DATABASE_SSL_CA_FILE=
# Alternativa para hospedagem: conteúdo completo do certificado raiz em uma variável secreta.
DATABASE_SSL_CA=

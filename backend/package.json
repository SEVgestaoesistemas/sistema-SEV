{
  "name": "sev-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API segura do SEV Gestão & Sistemas.",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "test:tenant-isolation": "node --env-file=.env --test test/security/tenant-isolation.integration.test.js test/security/support-chat.integration.test.js",
    "db:migrate": "node --env-file=.env src/db/migrate.js",
    "db:verify": "node --env-file=.env src/db/verify.js",
    "db:smoke": "node --env-file=.env scripts/smoke.js"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.11.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
